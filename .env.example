# Apps Script web-app URL that serves the sheet data (without the ?token= part)
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Shared secret checked by the Apps Script. Rotate it if it was ever committed.
VITE_API_TOKEN=change-me

# Optional: read daily sales straight from the Google Sheets API instead of Apps Script.
# The sheet must be shared "Anyone with the link: Viewer" for an API key to work.
VITE_SHEET_ID=
VITE_SHEETS_API_KEY=
